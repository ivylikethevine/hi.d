# Maintainer: Ivy Duggan <ivylikethevine@gmail.com>
#
# The VCS package, built from the branch. Identical to ../hi.d/ except for
# where the source comes from - keep package() in the two in step.

pkgname=hi.d-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="sshrc supercharged - your shell config, on every host you say hi to (git)"
arch=('any')
url="https://github.com/ivylikethevine/hi.d"
license=('MIT')
depends=('bash' 'openssh' 'openssl')
makedepends=('git')
provides=('hi.d')
conflicts=('hi.d')
optdepends=('zsh: zsh support on the client'
  'fish: fish support on the client'
  'docker: container targets'
  'podman: container targets'
  'nomad: allocation targets'
  'kubectl: pod targets')
# The `hi.d::` alias is load-bearing, not cosmetic: install.sh looks for a
# checkout named exactly hi.d under $srcdir, and without the alias git would
# clone to hi.d-git. It is also why this one needs no prepare().
source=("hi.d::git+$url.git#branch=main")
# SKIP is correct for a VCS source - there is no fixed tarball to sum
b2sums=('SKIP')

pkgver() {
  cd "$srcdir/hi.d"
  # no tags exist yet, so the rN.shorthash form rather than a git describe;
  # switch to describe once v1.0.0 is out and this package can sort against it
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  # see ../hi.d/PKGBUILD for why this is one line
  DESTDIR="$pkgdir" "$srcdir/hi.d/scripts/install.sh" --prefix /usr/share
  install -Dm644 "$srcdir/hi.d/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
