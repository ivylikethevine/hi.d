#!/bin/sh

PACKAGES=(
  # sudo
  # curl
  # wget
  # ping
  tldr
  # vi
  vim
  nano
  # rsync
  # tar
  # zip
  jq
  yq
  # netstat
  # avahi-daemon
  # neofetch
  docker
  # python
  # node
  rustup
  asdf
  direnv
  cosign
  # gpg
  # git
  # htop
  # bc
)

SYSTEMS=(
  apt
  pacman
  apk
  nix
  dpkg
  rpm
  dnf
  zypper
  pkgconf
  chocolatey
  choco
  wpkg
  appimage  # TODO: Determine how to check for AppImage support
  brew
  flatpak
  snap
  yay
  yum
  paru
  make # Is this a system? Idk but it seems useful to know
)

installed() {
  # TODO: Display important names from groups of commands based on priority
  # cecho_n "Installed: " $BRGREEN
  for package in "${PACKAGES[@]}"; do
    if command -v "$package" &>/dev/null; then
      cecho_n "$package ✓ " $GREEN
    fi
  done
  echo
}

missing() {
  # cecho_n "Missing:   " $BRYELLOW
  for package in "${PACKAGES[@]}"; do
    if ! command -v "$package" &>/dev/null; then
      cecho_n "$package ✗ " $BRYELLOW
    fi
  done
  echo
}

systems() {
  # cecho_n "Systems:   " $BRBLUE
  for system in "${SYSTEMS[@]}"; do
    if command -v "$system" &>/dev/null; then
      cecho_n "$system ✓ " $BLUE
    fi
  done
  # echo
}
