" must be first: launching as `vim -u <file>` implies 'compatible', which puts
" < in 'cpoptions' and disables <> key notation entirely - every <C-x>, <CR>,
" <Esc> and <Up> below would otherwise be mapped as literal text
" using -U might work as well, but would require modifications to this file
set nocompatible

set autoread
set ai
set backspace=eol,start,indent
set background=dark
set cmdheight=2
set encoding=utf8
set expandtab
set ffs=unix,dos,mac
set foldcolumn=1
set hid
set history=500
set hlsearch
set incsearch
set ignorecase
set langmenu=en
set lbr
set lazyredraw
set magic
set mat=2
set nobackup
set nowb
set noswapfile
set noerrorbells
set novisualbell
set ruler
set regexpengine=0
set smartcase
set showmatch
set showmode
set si
set so=7
set smarttab
set shiftwidth=2
set tm=500
set tabstop=2
set tw=500
set whichwrap+=<,>,h,l
set wrap
set wildmenu
set wildignore=*.o,*~,*.pyc
if has("win16") || has("win32")
  set wildignore+=.git\*,.hg\*,.svn\*
else
  set wildignore+=*/.git/*,*/.hg/*,*/.svn/*,*/.DS_Store
endif
try
  set switchbuf=useopen,usetab,newtab
  set stal=2
catch
endtry
try
  colorscheme slate
catch
endtry

syntax enable
filetype plugin on
filetype indent on
set laststatus=1

" Ctrl-X quits from any mode (overrides insert-mode completion prefix)
nnoremap <C-x> :qa!<CR>
inoremap <C-x> <Esc>:qa!<CR>
vnoremap <C-x> <Esc>:qa!<CR>
snoremap <C-x> <Esc>:qa!<CR>
onoremap <C-x> <Esc>:qa!<CR>
cnoremap <C-x> <C-c>:qa!<CR>
if exists(':tnoremap')
  tnoremap <C-x> <C-\><C-n>:qa!<CR>
endif
