#!/bin/bash
PACKAGES=(
  sudo
  curl
  wget
  ping
  # vi
  # vim
  nano
  rsync
  # tar
  # zip
  # jq
  # netstat
  # avahi-daemon
  # neofetch
  docker
  python
  node
  rustup
  # asdf-vm
  # direnv
)
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e -n "${BLUE}Available cmds: ${NC}| "
for package in "${PACKAGES[@]}"; do
  if command -v "$package" &>/dev/null; then
    echo -e -n "${GREEN}$package ✓ ${NC}| "
  else
    echo -e -n "${RED}$package ✗ ${NC}| "
  fi
done
echo
