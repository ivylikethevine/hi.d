#type,name,color
hosttag,desktop,green
hosttag,work,brblue
hosttag,laptop,brgreen
hosttag,personal,brgreen
username,root,magenta
username,admin,red
username,ubuntu,yellow
username,debian,brblue
usertag,work,cyan
#   type  = hosttag | username | hostname
#   color = red, green, yellow, blue, magenta, cyan, brred, brgreen, bryellow, brblue, brmagenta, brcyan
#   hosttag entries are matched against the leftmost tag in a "# Tags: ..." comment
#   directly above a "Host" line in ~/.ssh/config, e.g.:
#     # Tags: desktop
#     Host mymachine
# run `hi_color_preview` to preview what everything currently resolves to.
