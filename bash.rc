#!/bin/bash
if [ -f ~/.aliasesrc ]; then
  source ~/.aliasesrc
fi
if [ -f ~/aliases.rc ]; then
  source ~/aliases.rc
fi
if [ -f $SSHHOME/aliases.rc ]; then
  source ~/aliases.rc
fi

# Bash configuration SSHRC
HISTCONTROL=ignoreboth
HISTSIZE=2000
HISTFILESIZE=2000

shopt -s histappend
shopt -s checkwinsize
shopt -s globstar

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
  debian_chroot=$(cat /etc/debian_chroot)
fi
case "$TERM" in
xterm-color | *-256color) color_prompt=yes ;;
esac
force_color_prompt=yes
if [ -n "$force_color_prompt" ]; then
  if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    color_prompt=yes
  else
    color_prompt=
  fi
fi
# TODO: Unify these colors with the ones in ssh.rc/config.fish/zsh.rc/check.rc
if [ "$color_prompt" = yes ]; then
  USER_COLOR='32m'
  HOST_COLOR='32m'
  AT_COLOR='32m'
  if [[ ${SSH_TTY} ]]; then
    AT_COLOR='33m' # yellow
  fi
  if [ "$(hostname)" = "swervy" -o "$(hostname)" = "melchior" -o "$(hostname)" = "lenny" -o "$(hostname)" = "clyde" ]; then
    HOST_COLOR='31m' # red
  fi
  if [ "$(hostname)" = "bertha" -o "$(hostname)" = "liona" -o "$(hostname)" = "mavie" ]; then
    HOST_COLOR='35m' # purple
  fi
  if [ "$(hostname)" = "minty" -o "$(hostname)" = "sherrie" ]; then
    HOST_COLOR='34m' # blue
  fi
  if [ "$(hostname)" = "gendo" -o "$(hostname)" = "ryoji" -o "$(hostname)" = "shinji" -o "$(hostname)" = "edison" ]; then
    HOST_COLOR='32m' # green
  fi
  if [ "$(whoami)" = "root" -o "$(whoami)" = "admin" ]; then
    USER_COLOR='31m' # red
  fi
  if [ "$(whoami)" = "team" -o "$(whoami)" = "edison" ]; then
    USER_COLOR='33m' # yellow
  fi
  PS1='${debian_chroot:+($debian_chroot)}\[\033[01;${USER_COLOR}\]\u\[\033[01;${AT_COLOR}\]@\[\033[01;${HOST_COLOR}\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
  PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt
case "$TERM" in
xterm* | rxvt*)
  PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
  ;;
*) ;;
esac
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

hi() {
  sshrc "$@"
  if [ $? -eq 0 ]; then
    echo -n "" # no-op
  else
    echo -e "\n\033[01;31m====================================\033[00;0m"
    echo -e "\033[01;33msshrc failed, falling back to ssh...\033[00;0m"
    echo -e "\033[01;31m====================================\033[00;0m\n"
    ssh "$@"
  fi
}
