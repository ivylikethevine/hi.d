include "/usr/share/nano/*.nanorc"
include "/usr/share/nano/extra/*.nanorc"
# include "/usr/share/nano-syntax-highlighting/*.nanorc" # specific completion syntax should be sourced in ~/.nanorc, not here, as it won't be available on every target system

set atblanks
set autoindent
set breaklonglines
set constantshow
set indicator
set linenumbers
set mouse
set softwrap
set tabsize 2
set tabstospaces
set whitespace "·»"
set zap

set titlecolor brightwhite,blue
set statuscolor brightwhite,magenta
set selectedcolor black,green
set errorcolor brightwhite,red
set numbercolor black,white
set functioncolor cyan
set scrollercolor brightcyan
