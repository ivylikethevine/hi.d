#!/bin/sh
BLACK='\e[0;30m'
RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
BLUE='\e[0;34m'
PURPLE='\e[0;35m'
CYAN='\e[0;36m'
WHITE='\e[0;37m'
BOLD_BLACK='\e[1;30m'
BOLD_RED='\e[1;31m'
BOLD_GREEN='\e[1;32m'
BOLD_YELLOW='\e[1;33m'
BOLD_BLUE='\e[1;34m'
BOLD_PURPLE='\e[1;35m'
BOLD_CYAN='\e[1;36m'
BOLD_WHITE='\e[1;37m'
NC='\e[0m'
sshrc_start="# sshrc-config-start"
sshrc_end="# sshrc-config-end"

colecho() {
  echo -e "$2$1${NC}"
}

colecho_n() {
  echo -e -n "$2$1${NC}"
}

time_display() {
  echo -e " ${BOLD_CYAN}$(date -u "+%a %b %e %H:%M:%S %Z %Y") ${NC}|${BOLD_YELLOW} $(date "+%a %b %e %H:%M:%S %Z %Y")${NC}"
}

remove_between() {
  if test -f $1; then
    sed -i "/^$sshrc_start/,/^$sshrc_end/d" -- $1
  fi
}

copy_config() {
  touch $1
  if ! grep -q "$sshrc_start" $1; then
    echo "$sshrc_start" >>$1
    cat "$SSHHOME/.sshrc.d/$2" >>$1
    echo "$sshrc_end" >>$1
  fi
}

header() {
  touch ~/.hushlogin # only works on subsequent logins :/ -> sshrc uses bash for the initial shell, so we should always create this
  colecho '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' $BOLD_GREEN
  time_display
  colecho_n " Connected!" $BOLD_GREEN
  colecho_n " | " $NC
  colecho_n "OS: $(uname -s)" $CYAN
  colecho_n " | " $NC
  colecho_n "Arch: $(uname -m)" $YELLOW
  colecho_n " | " $NC
  colecho "$(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')" $BLUE
}

footer() {
  colecho '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' $BOLD_RED
  time_display
  colecho_n " sshrc closing! " $BLUE
  # rm ~/.hushlogin # would like to remove this after we leave, but can't :/
  exit 0
}

trap 'remove_between ~/.zshrc; remove_between ~/.nanorc; remove_between ~/.config/fish/config.fish' EXIT
header

source $SSHHOME/.sshrc.d/aliases.rc
source $SSHHOME/.sshrc.d/check.rc

if [ ! -f /bin/bash ]; then
  if [ ! -f /usr/bin/bash ]; then
    colecho "No bash... sorry :~(" $BOLD_RED
    sh # sshrc doesn't run on sh.... crashes connection
    footer
  fi
fi

export VIMINIT="let \$MYVIMRC='$SSHHOME/.sshrc.d/vim.rc' | source \$MYVIMRC"
copy_config ~/.nanorc nano.rc

source $SSHHOME/.sshrc.d/bash.rc
copy_config ~/.zshrc zsh.rc

colecho_n " sshrc loaded with... " $BLUE

if [ -d /usr/share/fish/functions ]; then
  colecho "fish shell! :^)" $GREEN
  copy_config ~/.config/fish/config.fish config.fish
  fish -C "source ${SSHHOME}/.sshrc.d/aliases.rc && set fish_greeting ''" -i
elif [ -d /usr/share/zsh/functions ]; then
  colecho "zsh shell! :)" $PURPLE
  zsh -i
else
  colecho "only bash today :(" $RED
  bash -i
fi

footer
