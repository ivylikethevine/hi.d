#!/bin/sh

if [ ! -f /bin/bash ]; then
  if [ ! -f /usr/bin/bash ]; then
    echo "No bash... sorry :~("
    sh # sshrc doesn't run on sh.... crashes connection
    exit 0
  fi
fi

# ---------- TEMP ----------
sshrc_start="# sshrc-config-start"
sshrc_end="# sshrc-config-end"
trap 'remove_between ~/.zshrc; remove_between ~/.nanorc; ' EXIT

remove_between() {
  sed -i "/^$sshrc_start/,/^$sshrc_end/d" -- $1
}

copy_config() {
  touch $1
  if ! grep -q "$sshrc_start" $1; then
    echo "$sshrc_start" >>$1
    cat "$SSHHOME/.sshrc.d/$2" >>$1
    echo "$sshrc_end" >>$1
  fi
}

# Zsh configuration creation
copy_config ~/.zshrc .zshrc

# Nano configuration creation
copy_config ~/.nanorc .nanorc

# Vim configuration
export VIMINIT="let \$MYVIMRC='$SSHHOME/.sshrc.d/.vimrc' | source \$MYVIMRC"

source $SSHHOME/.sshrc.d/.checkrc

# Final setup
PURPLE='\033[0;35m' # purple
BLUE='\033[0;34m'   # blue
GREEN='\033[0;32m'  # green
RED='\033[0;31m'    # red
NC='\033[0m'        # No Color
echo -e -n "${BLUE}sshrc loaded with... ${NC}"

if [ -d /usr/share/fish/functions ]; then
  echo -e "${GREEN}fish shell! ${NC}:^)"
  # Load aliases into fish & remove welcome message
  fish -C "source ${SSHHOME}/.sshrc.d/.aliasesrc && set fish_greeting \"\"" -i
  echo -e "${BLUE}sshrc closing!${NC}"
  exit 0
elif [ -d /usr/share/zsh/functions ]; then
  echo -e "${PURPLE}zsh shell! ${NC}:)"
  export ZDOTDIR=$SSHHOME/.sshrc.d
  zsh -i
  echo -e "${BLUE}sshrc closing!${NC}"
  exit 0
else
  # Bash Profile
  source $SSHHOME/.sshrc.d/.bashrc
  source $SSHHOME/.sshrc.d/.aliasesrc
  echo -e "${RED}only bash today ${NC}:("
fi
