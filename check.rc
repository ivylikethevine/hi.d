#!/bin/bash

PACKAGES=(
  sudo
  curl
  wget
  ping
  # vi
  # vim
  nano
  # rsync
  # tar
  # zip
  # jq
  # netstat
  # avahi-daemon
  # neofetch
  docker
  # python
  # node
  # rustup
  asdf
  # direnv
)

colecho_n "Available cmds:" $BLUE
colecho_n " | " $NC
for package in "${PACKAGES[@]}"; do
  if command -v "$package" &>/dev/null; then
    colecho_n "$package ✓" $GREEN
    colecho_n " | " $NC
  else
    colecho_n "$package ✗" $RED
    colecho_n " | " $NC
  fi
done
echo
