# Zsh Configuration SSHRC
if [ -f ~/.aliasesrc ]; then
  source ~/.aliasesrc
fi
if [ -f ~/aliases.rc ]; then
  source ~/aliases.rc
fi
if [ -f $SSHHOME/aliases.rc ]; then
  source ~/aliases.rc
fi

HISTFILE=~/.zsh_history
HISTSIZE=2000
SAVEHIST=2000

autoload -Uz compinit
compinit
compdef sshrc=ssh

autoload -Uz promptinit
promptinit
prompt adam1

bindkey -e

# homekey
bindkey "^[OH" beginning-of-line
bindkey "^[[H" beginning-of-line
bindkey "^[[1;5H" backward-word
bindkey "^[[1;5D" backward-word

# endkey
bindkey "^[OF" end-of-line
bindkey "^[[F" end-of-line
bindkey "^[[1;5F" forward-word
bindkey "^[[1;5C" forward-word

# delkey
bindkey "^[[3;5~" delete-word

setopt histignorealldups sharehistory
unsetopt beep

zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu select=2

eval "$(dircolors -b)"
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' menu select=long
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

function hi() {
  sshrc "$@"
  if [ $? -eq 0 ]; then
    echo -n "" # no-op
  else
    echo -e "\n\033[01;31m====================================\033[00;0m"
    echo -e "\033[01;33msshrc failed, falling back to ssh...\033[00;0m"
    echo -e "\033[01;31m====================================\033[00;0m\n"
    ssh "$@"
  fi
}
# TODO: Add colored user/hostname/@ symbols for hosts as per bash and fish shells

# Spelled vew to avoid calling vi
# TODO: add option supports
vew() {
  # $1 – path to inspect
  local p="${1:-}"

  # Argument check
  if [[ -z "$p" ]]; then
    printf 'Usage: %s <file_or_directory>\n' "${FUNCNAME[0]}" >&2
    return 1
  fi

  # Regular file → cat
  if [[ -f "$p" ]]; then
    cat -- "$p"

  # Directory → list (what you prefer, here a plain `ls -l`)
  elif [[ -d "$p" ]]; then
    ls -l -- "$p"

  # Anything else (symlink to a non‑regular file, device, nonexistent, …)
  else
    printf 'Error: %s is not a regular file or directory.\n' "$p" >&2
    return 2
  fi
}
