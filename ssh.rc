#!/bin/sh
RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
BLUE='\e[0;34m'
PURPLE='\e[0;35m'
CYAN='\e[0;36m'
BRRED='\e[1;31m'
BRGREEN='\e[1;32m'
BRYELLOW='\e[1;33m'
BRBLUE='\e[1;34m'
BRPURPLE='\e[1;35m'
BRCYAN='\e[1;36m'
NC='\e[0m'

sshrc_exclude="--exclude .git --exclude .gitignore --exclude README.md --exclude hi.sh"
sshrc_start="# sshrc-config-start"
sshrc_end="# sshrc-config-end"

cecho() {
  echo -e "$2$1$NC"
}

cecho_n() {
  echo -ne "$2$1$NC"
}

spacer() {
  cecho_n " | " $NC
}

timestamp() {
  spacer
  echo -e "$BRBLUE$(date -u "+%a %b %e %H:%M:%S %Z %Y")   $NC|$BRYELLOW   $(date "+%a %b %e %H:%M:%S %Z %Y")$NC"
  spacer
}

configure() {
  touch $1
  if ! grep -q "$sshrc_start" $1; then
    echo "$sshrc_start" >>$1
    cat "$SSHHOME/.sshrc.d/$2" >>$1
    echo "$sshrc_end" >>$1
  fi
}

deconfigure() {
  if test -f $1; then
    sed -i "/^$sshrc_start/,/^$sshrc_end/d" -- $1
  fi
}

clean() {
  deconfigure ~/.bashrc
  deconfigure ~/.zshrc
  deconfigure ~/.nanorc
  deconfigure ~/.config/fish/config.fish
  if [ -f ~/.aliasesrc ]; then
    rm -f ~/.aliasesrc
  fi
  if [ -f ~/.hushlogin ]; then
    rm -f ~/.hushlogin
  fi
}

header() {
  cecho '~~~~~~~~~~~~~~~~~~~~~~~~ Connected! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~' $BRGREEN
  timestamp
  cecho_n "$(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')" $GREEN
  spacer
  cecho_n "$(uname -m)" $PURPLE
  spacer

  if [ -f /usr/bin/docker ]; then
    cecho "Running Containers: $(docker container ls | wc -l | awk '{print $1 - 1}')" $BLUE
  else
    cecho "Counting impossible, no docker :(" $BRYELLOW
  fi

  spacer
  if [ -f ~/.gitconfig ]; then
    cecho_n "Github Identity Found: " $CYAN
    cecho_n "$(cat ~/.gitconfig | grep email | cut -d= -f2 | tr -d ' ' | awk -F@ '{for(i=0;i<length($2);i++) c=c"●"; print $1"@"c; c=""}')" $YELLOW
  else
    cecho_n "No Github Identity Found..." $YELLOW
  fi

  spacer
  cecho_n "Authorized: $(ls ~/.ssh | grep authorized_keys | wc -l)" $RED
  spacer
  cecho "Public: $(ls ~/.ssh | grep .pub | wc -l)" $PURPLE
}

footer() {
  cecho_n " $(du -sh $sshrc_exclude --apparent-size $SSHHOME/.sshrc.d | awk '{ print $1 }') " $NC
  cecho '~~~~~~~~~~~~~~~~~~~~~~~ Disconnected! ~~~~~~~~~~~~~~~~~~~~~~~~~~' $BRRED
  timestamp
  cecho_n "sshrc closing! " $BRCYAN
  exit 0
}

run_sshrc() {
  trap 'clean' EXIT
  header

  source $SSHHOME/.sshrc.d/check.rc
  systems
  installed
  missing

  export VIMINIT="let \$MYVIMRC='$SSHHOME/.sshrc.d/vim.rc' | source \$MYVIMRC"
  configure ~/.nanorc nano.rc
  configure ~/.bashrc bash.rc
  configure ~/.zshrc zsh.rc
  configure ~/.aliasesrc aliases.rc

  spacer
  cecho_n "sshrc loaded with... " $BLUE

  if [ -f /usr/bin/fish ]; then
    cecho "fish shell! :^)" $GREEN
    configure ~/.config/fish/config.fish config.fish
    fish -C "source $SSHHOME/.sshrc.d/aliases.rc && set fish_greeting ''" -i
  elif [ -f /usr/bin/zsh ]; then
    cecho "zsh shell! :)" $PURPLE
    zsh -i
  else
    cecho "only bash today :(" $RED
    bash -i
  fi

  footer
}
