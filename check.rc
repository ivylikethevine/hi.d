#!/bin/sh

PACKAGES=(
  sudo
  curl
  wget
  ping
  tldr
  vi
  vim
  nano
  rsync
  tar
  zip
  jq
  netstat
  avahi-daemon
  neofetch
  docker
  python
  node
  rustup
  asdf
  direnv
  cosign
  gpg
  git
  yq
  htop
)

# TODO: Display important names from groups of commands based on priority
colecho_n " Installed:" $BOLD_CYAN
colecho_n " | " $NC
for package in "${PACKAGES[@]}"; do
  if command -v "$package" &>/dev/null; then
    colecho_n "$package ✓ " $GREEN
  else
    colecho_n "" # do nothing
  fi
done

echo
colecho_n " Missing:  " $BOLD_YELLOW
colecho_n " | " $NC
for package in "${PACKAGES[@]}"; do
  if command -v "$package" &>/dev/null; then
    colecho_n "" # do nothing
  else
    colecho_n "$package ✗ " $YELLOW
  fi
done
echo
