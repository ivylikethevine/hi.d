#!/bin/sh

PACKAGES=(
  # sudo
  # curl
  wget
  ping
  tldr
  # vi
  # vim
  nano
  # rsync
  # tar
  zip
  jq
  yq
  # netstat
  # avahi-daemon
  neofetch
  docker
  python
  node
  rustup
  asdf
  # direnv
  # cosign
  gpg
  git
  htop
  # bc
)

# TODO: Display important names from groups of commands based on priority
spacer
colecho_n "Installed: " $BOLD_CYAN
for package in "${PACKAGES[@]}"; do
  if command -v "$package" &>/dev/null; then
    colecho_n "$package ✓ " $GREEN
  fi
done

echo
spacer
colecho_n "Missing:   " $BOLD_YELLOW
# colecho_n " | " $NC
for package in "${PACKAGES[@]}"; do
  if ! command -v "$package" &>/dev/null; then
    colecho_n "$package ✗ " $YELLOW
  fi
done
echo
