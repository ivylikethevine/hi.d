#!/bin/sh

PACKAGES=(
  # sudo
  # curl
  # wget
  # ping
  bat # improved cat
  tldr
  # vi
  vim
  nano
  # rsync
  # tar
  # zip
  jq
  yq
  # netstat
  # avahi-daemon
  # neofetch
  # docker
  # python
  # node
  rustup
  asdf
  direnv
  cosign
  # gpg
  # git
  # htop
  # bc
  sshpass
  # openssl
)

SYSTEMS=(
  apt
  pacman
  apk
  nix
  dpkg
  rpm
  dnf
  zypper
  # pkgconf
  # chocolatey
  choco
  wpkg
  # appimage
  fusermount # Surrogate for appimage?
  brew
  flatpak
  snap
  # yay
  # yum
  # paru
  # make # Is this a system? Idk but it seems useful to know
  # cmake
  # systemd
  systemctl
)

installed() {
  # TODO: Display important names from groups of commands based on priority?
  for package in "${PACKAGES[@]}"; do
    if command -v "$package" &>/dev/null; then
      cecho_n "$package ✓ " $GREEN
    fi
  done
  echo
}

missing() {
  for package in "${PACKAGES[@]}"; do
    if ! command -v "$package" &>/dev/null; then
      cecho_n "$package ✗ " $BRYELLOW
    fi
  done
  echo
}

systems() {
  for system in "${SYSTEMS[@]}"; do
    if command -v "$system" &>/dev/null; then
      cecho_n "$system ✓ " $BLUE
    fi
  done
}
